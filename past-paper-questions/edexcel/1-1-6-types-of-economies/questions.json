sFigure":false},{"id":"edexcel-as-p1-2019-jun-q6g","p":30,"section":"B","questionNumber":"6(g)","parentQuestion":"6","choiceGroup":"edexcel-as-p1-2019-jun-q6-choice","marks":20,"questionText":"Evaluate the possible disadvantages of a free market approach to providing health care.","topics":["1-1-6-types-of-economies","1-3-1-types-of-market-failure"],"board":"edexcel","groups":["theme-1"],"keywords":["free market","health care","market failure","private provision"],"qpPage":16,"msPage":21,"ctxPage":13,"modelAnswer":null},{"id":"edexcel-as-p1-2018-jun-q1b","p":29,"section":"A","questionNumber":"1(b)","parentQuestion":"1","choiceGroup":null,"marks":2,"questionText":"Statement 1: Cuba has a healthcare system with a patient to doctor ratio of 155:1. Statement 2: Other countries ought to adopt a similar healthcare system to that which exists in Cuba. Cuba’s population is estimated to be 11 million. With reference to Statement 1 above, calculate the estimated number of doctors in Cuba. You are advised to show your working.","topics":["1-1-6-types-of-economies"],"board":"edexcel","groups":["theme-1"],"keywords":["calculation","ratio","healthcare","Cuba"],"qpPage":2,"msPage":4,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-as-p1-2018-jun-q1c","p":29,"section":"A","questionNumber":"1(c)","parentQuestion":"1","choiceGroup":null,"marks":1,"questionText":"Statement 1: Cuba has a healthcare system with a patient to doctor ratio of 155:1. Statement 2: Other countries ought to adopt a similar healthcare system to that which exists in Cuba. Define the term ‘command economy’.","topics":["1-1-6-types-of-economies"],"board":"edexcel","groups":["theme-1"],"keywords":["command economy","definition"],"qpPage":3,"msPage":4,"ctxPage":2,"modelAnswer":null,"ctxLabel":"Question 1 as printed"},{"id":"edexcel-as-p1-2018-jun-q3b","p":29,"section":"A","questionNumber":"3(b)","parentQuestion":"3","choiceGroup":null,"marks":2,"questionText":"In the UK charges for dental treatment vary. For exampl