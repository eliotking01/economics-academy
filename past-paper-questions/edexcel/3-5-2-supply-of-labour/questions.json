,"3-5-2-supply-of-labour":{"spec":"3.5.2","title":"Supply of Labour","shortTitle":"Supply of Labour","board":"edexcel","boardName":"Edexcel A","group":"theme-3","groupLabel":"Theme 3","groupName":"Business Behaviour and the Labour Market","unit":"3.5","unitName":"Labour Market","notesUrl":"/revision-notes/edexcel-theme-3/3-5-2-supply-of-labour.html","questionsUrl":"/practice-questions/edexcel-theme-3/3-5-2-supply-of-labour.html","url":"/past-paper-questions/edexcel/3-5-2-supply-of-labour/","count":8,"gated":true,"hasPage":true},"3-5-3-wage-determination":{"spec":"3.5.3","title":"Wage Determination","shortTitle":"Wage Determination","board":"edexcel","boardName":"Edexcel A","group":"theme-3","groupLabel":"Theme 3","groupName":"Business Behaviour and the Labour Market","unit":"3.5","unitName":"Labour Market","notesUrl":"/revision-notes/edexcel-theme-3/3-5-3-wage-determination.html","questionsUrl":"/practice-questions/edexcel-theme-3/3-5-3-wage-determination.html","url":"/past-paper-questions/edexcel/3-5-3-wage-determination/","count":10,"gated":true,"hasPage":true}},"questions":[{"id":"edexcel-a-p1-2025-jun-q5b","p":6,"section":"A","questionNumber":"5(b)","parentQuestion":"5","choiceGroup":null,"marks":1,"questionText":"The National Minimum Wage for people over 23 rose by 9.7% to £10.42 in April 2023. The industry most affected is hospitality. There has been a significant decrease in the supply of agricultural workers in the UK. Which one of the following is the most likely cause of this decrease?","topics":["3-5-2-supply-of-labour"],"board":"edexcel","groups":["theme-3"],"keywords":["supply of labour","agricultural workers","wages"],"qpPage":10,"msPage":8,"ctxPage":null,"modelAnswer":null,"type":"mcq","options":["Increased demand for UK-grown strawberries","Increased job security for qualified workers in the industry","Increased productivity of workers in the industry","Increased wages in the retail industry"],"usesFigure":false},{"id":"edexcel-a-p1-2025-jun-q8","p":6,"section":"C","questionNumber":"8","parentQuestion":null,"choiceGroup":"edexcel-a-p1-2025-jun-sec-c","marks":25,"questionText":"In 2023, the UK prime minister Rishi Sunak said that he wanted to see all students in England study some form of mathematics until they reach the age of 18 to ‘ensure that they leave school better equipped for the jobs of the future’. This would require additional spending on education. Just half of all 16 to 19 year-olds study mathematics. Yet in a world where data is everywhere and statistics are vital in every job, the workforce will require more analytical skills than ever before. Evaluate the likely microeconomic effects of increased spending on education.","topics":["1-3-2-externalities","3-5-2-supply-of-labour"],"board":"edexcel","groups":["theme-1","theme-3"],"keywords":["education spending","positive externalities","human capital","skills"],"qpPage":26,"msPage":24,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p1-2024-jun-q6b","p":5,"section":"B","questionNumber":"6(b)","parentQuestion":"6","choiceGroup":null,"marks":8,"questionText":"Examine two factors which might influence the supply of labour in the electronics industry.","topics":["3-5-2-supply-of-labour"],"board":"edexcel","groups":["theme-3"],"keywords":["supply of labour","labour market","electronics industry"],"qpPage":12,"msPage":14,"ctxPage":10,"modelAnswer":null},{"id":"edexcel-a-p3-2023-jun-q2e","p":22,"section":"B","questionNumber":"2(e)","parentQuestion":"2","choiceGroup":"edexcel-a-p3-2023-jun-q2-choice","marks":25,"questionText":"Evaluate the microeconomic and macroeconomic effects of labour shortages in the UK, or a developed economy of your choice.","topics":["3-5-2-supply-of-labour","2-1-3-employment-unemployment"],"board":"edexcel","groups":["theme-2","theme-3"],"keywords":["labour shortages","supply of labour","vacancies","UK"],"qpPage":21,"msPage":26,"ctxPage":19,"modelAnswer":null},{"id":"edexcel-a-p1-2022-jun-q8","p":3,"section":"C","questionNumber":"8","parentQuestion":null,"choiceGroup":"edexcel-a-p1-2022-jun-sec-c","marks":25,"questionText":"Some occupations in the UK are facing large labour shortages. Hard-to-fill vacancies include qualified chefs, software engineers, construction workers and qualified nurses. Evaluate the factors that might influence the supply of labour in an occupation of your choice.","topics":["3-5-2-supply-of-labour"],"board":"edexcel","groups":["theme-3"],"keywords":["supply of labour","labour shortages","vacancies","labour market"],"qpPage":29,"msPage":23,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p1-2021-nov-q1b","p":7,"section":"A","questionNumber":"1(b)","parentQuestion":"1","choiceGroup":null,"marks":4,"questionText":"Statement 1: Since Poland joined the European Union (EU) in 2004, over one million of its workforce have migrated to other countries in the EU. Statement 2: Many engineers have left Poland for higher paid jobs in other countries in the EU. Explain the likely impact of migration on the wage level of engineers in Poland.","topics":["3-5-2-supply-of-labour","3-5-3-wage-determination"],"board":"edexcel","groups":["theme-3"],"keywords":["migration","supply of labour","wages","engineers"],"qpPage":3,"msPage":4,"ctxPage":2,"modelAnswer":null,"ctxLabel":"Question 1 as printed"},{"id":"edexcel-a-p3-2021-nov-q1c","p":25,"section":"A","questionNumber":"1(c)","parentQuestion":"1","choiceGroup":null,"marks":12,"questionText":"Discuss the likely effects of changes in the level of migration on firms such as HCWs in the UK. Use a labour market diagram and the information provided to support your answer.","topics":["3-5-2-supply-of-labour"],"board":"edexcel","groups":["theme-3"],"keywords":["migration","supply of labour","labour market diagram","wages"],"qpPage":5,"msPage":6,"ctxPage":2,"modelAnswer":null},{"id":"edexcel-a-p1-2018-jun-q6e","p":1,"section":"B","questionNumber":"6(e)","parentQuestion":"6","choiceGroup":null,"marks":15,"questionText":"With reference to Extract C and your own knowledge, discuss policies businesses and government might implement to reduce labour immobility to benefit the energy sector.","topics":["3-5-2-supply-of-labour"],"board":"edexcel","groups":["theme-3"],"keywords":["labour immobility","geographical immobility","occupational immobility","training"],"qpPage":19,"msPage":20,"ctxPage":17,"modelAnswer":null}]}
