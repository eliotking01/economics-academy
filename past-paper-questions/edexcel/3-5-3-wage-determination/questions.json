ony","board":"edexcel","boardName":"Edexcel A","group":"theme-3","groupLabel":"Theme 3","groupName":"Business Behaviour and the Labour Market","unit":"3.4","unitName":"Market Structures","notesUrl":"/revision-notes/edexcel-theme-3/3-4-6-monopsony.html","questionsUrl":"/practice-questions/edexcel-theme-3/3-4-6-monopsony.html","url":"/past-paper-questions/edexcel/3-4-6-monopsony/","count":4,"gated":true,"hasPage":true},"3-5-2-supply-of-labour":{"spec":"3.5.2","title":"Supply of Labour","shortTitle":"Supply of Labour","board":"edexcel","boardName":"Edexcel A","group":"theme-3","groupLabel":"Theme 3","groupName":"Business Behaviour and the Labour Market","unit":"3.5","unitName":"Labour Market","notesUrl":"/revision-notes/edexcel-theme-3/3-5-2-supply-of-labour.html","questionsUrl":"/practice-questions/edexcel-theme-3/3-5-2-supply-of-labour.html","url":"/past-paper-questions/edexcel/3-5-2-supply-of-labour/","count":7,"gated":true,"hasPage":true},"3-5-3-wage-determination":{"spec":"3.5.3","title":"Wage Determination","shortTitle":"Wage Determination","board":"edexcel","boardName":"Edexcel A","group":"theme-3","groupLabel":"Theme 3","groupName":"Business Behaviour and the Labour Market","unit":"3.5","unitName":"Labour Market","notesUrl":"/revision-notes/edexcel-theme-3/3-5-3-wage-determination.html","questionsUrl":"/practice-questions/edexcel-theme-3/3-5-3-wage-determination.html","url":"/past-paper-questions/edexcel/3-5-3-wage-determination/","count":9,"gated":true,"hasPage":true},"3-6-1-government-intervention":{"spec":"3.6.1","title":"Government Intervention","shortTitle":"Government Intervention","board":"edexcel","boardName":"Edexcel A","group":"theme-3","groupLabel":"Theme 3","groupName":"Business Behaviour and the Labour Market","unit":"3.6","unitName":"Government Intervention","notesUrl":"/revision-notes/edexcel-theme-3/3-6-1-government-intervention.html","questionsUrl":"/practice-questions/edexcel-theme-3/3-6-1-government-intervention.html","url":"/past-paper-questions/edexcel/3-6-1-government-intervention/","count":11,"gated":true,"hasPage":true}},"questions":[{"id":"edexcel-a-p1-2025-jun-q5a","p":6,"section":"A","questionNumber":"5(a)","parentQuestion":"5","choiceGroup":null,"marks":4,"questionText":"The National Minimum Wage for people over 23 rose by 9.7% to £10.42 in April 2023. The industry most affected is hospitality. Draw a labour market diagram to show the likely impact of the increase in the National Minimum Wage for hospitality employees.","topics":["3-5-3-wage-determination"],"board":"edexcel","groups":["theme-3"],"keywords":["national minimum wage","labour market diagram","hospitality"],"qpPage":10,"msPage":8,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p3-2025-jun-q1b","p":24,"section":"A","questionNumber":"1(b)","parentQuestion":"1","choiceGroup":null,"marks":8,"questionText":"With reference to Extract B, examine two likely reasons why wages in supermarkets are above the National Minimum Wage of £10.42.","topics":["3-5-3-wage-determination"],"board":"edexcel","groups":["theme-3"],"keywords":["wages","National Minimum Wage","supermarkets","labour shortages"],"qpPage":2,"msPage":5,"ctxPage":31,"modelAnswer":null},{"id":"edexcel-a-p3-2024-jun-q1d","p":23,"section":"A","questionNumber":"1(d)","parentQuestion":"1","choiceGroup":"edexcel-a-p3-2024-jun-q1-choice","marks":25,"questionText":"Evaluate the microeconomic and macroeconomic factors that explain gender-based wage differences in the UK oil and gas industry.","topics":["3-5-3-wage-determination"],"board":"edexcel","groups":["theme-3"],"keywords":["gender pay gap","wage differentials","labour market","oil and gas"],"qpPage":5,"msPage":10,"ctxPage":3,"modelAnswer":null},{"id":"edexcel-a-p1-2023-jun-q5b","p":4,"section":"A","questionNumber":"5(b)","parentQuestion":"5","choiceGroup":null,"marks":4,"questionText":"Index of pay in the public and private sector. Over 90% of nurses work in the public sector. Nurses in the public sector have experienced wage rises lower than those in the private sector over the past 10 years. Using the information provided and the concept of monopsony, explain why nurses in the public sector have had lower wage rises than those in the private sector.","topics":["3-4-6-monopsony","3-5-3-wage-determination"],"board":"edexcel","groups":["theme-3"],"keywords":["monopsony","nurses","public sector pay","wages"],"qpPage":11,"msPage":9,"ctxPage":10,"modelAnswer":null,"ctxLabel":"Question 5 as printed"},{"id":"edexcel-a-p3-2022-jun-q1e","p":21,"section":"A","questionNumber":"1(e)","parentQuestion":"1","choiceGroup":"edexcel-a-p3-2022-jun-q1-choice","marks":25,"questionText":"Evaluate the microeconomic and macroeconomic effects of significant increases in the minimum wage. Refer to restaurants or other food delivery services in your answer.","topics":["3-5-3-wage-determination","3-6-1-government-intervention"],"board":"edexcel","groups":["theme-3"],"keywords":["minimum wage","labour market","wage floor","restaurants"],"qpPage":5,"msPage":12,"ctxPage":3,"modelAnswer":null},{"id":"edexcel-a-p1-2021-nov-q1b","p":7,"section":"A","questionNumber":"1(b)","parentQuestion":"1","choiceGroup":null,"marks":4,"questionText":"Statement 1: Since Poland joined the European Union (EU) in 2004, over one million of its workforce have migrated to other countries in the EU. Statement 2: Many engineers have left Poland for higher paid jobs in other countries in the EU. Explain the likely impact of migration on the wage level of engineers in Poland.","topics":["3-5-2-supply-of-labour","3-5-3-wage-determination"],"board":"edexcel","groups":["theme-3"],"keywords":["migration","supply of labour","wages","engineers"],"qpPage":3,"msPage":4,"ctxPage":2,"modelAnswer":null,"ctxLabel":"Question 1 as printed"},{"id":"edexcel-a-p1-2021-nov-q7","p":7,"section":"C","questionNumber":"7","parentQuestion":null,"choiceGroup":"edexcel-a-p1-2021-nov-sec-c","marks":25,"questionText":"The national living wage, the minimum wage for 25-year-olds and over, is expected to rise to more than £10.50 an hour in 2024 compared with £8.72 in 2020. The wage does not apply to the UK’s self-employed and ‘gig economy’ workers. Some economists said the increase was ambitious. Business groups warned that employers in sectors such as social care could be hit hard. In large parts of the north of England the living wage has already reached two-thirds of local median earnings, said Professor Shackleton. Evaluate the disadvantages of a significant increase in the national living wage on a specific labour market, such as that for social care workers.","topics":["3-5-3-wage-determination","3-6-1-government-intervention"],"board":"edexcel","groups":["theme-3"],"keywords":["national living wage","minimum wage","labour market","social care"],"qpPage":30,"msPage":23,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p1-2019-jun-q7","p":2,"section":"C","questionNumber":"7","parentQuestion":null,"choiceGroup":"edexcel-a-p1-2019-jun-sec-c","marks":25,"questionText":"In July 2017 it was announced that only a third of the BBC’s 96 top earning presenters were women and that its seven highest-paid presenters were all men. According to the High Pay Centre, in 2018, UK chief executives can earn 120 times more than the average full-time worker earning £28 758. With reference to an industry of your choice, evaluate why wage differences exist within the UK labour market.","topics":["3-5-3-wage-determination"],"board":"edexcel","groups":["theme-3"],"keywords":["wage differentials","gender pay gap","labour market","wage determination"],"qpPage":26,"msPage":19,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p3-2017-jun-q2c","p":18,"section":"B","questionNumber":"2(c)","parentQuestion":"2","choiceGroup":null,"marks":12,"questionText":"Discuss the likely impact of the National Living Wage on the profitability of firms. Use a cost and revenue diagram in your answer.","topics":["3-5-3-wage-determination","3-3-4-normal-profits-supernormal-profits-losses"],"board":"edexcel","groups":["theme-3"],"keywords":["national living wage","minimum wage","profitability","cost and revenue diagram"],"qpPage":22,"msPage":16,"ctxPage":21,"modelAnswer":null}]}
