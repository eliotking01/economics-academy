ent-expenditure":{"spec":"2.2.4","title":"Government Expenditure","shortTitle":"Government Expenditure","board":"edexcel","boardName":"Edexcel A","group":"theme-2","groupLabel":"Theme 2","groupName":"The UK Economy — Performance and Policies","unit":"2.2","unitName":"Aggregate Demand (AD)","notesUrl":"/revision-notes/edexcel-theme-2/2-2-4-government-expenditure.html","questionsUrl":"/practice-questions/edexcel-theme-2/2-2-4-government-expenditure.html","url":"/past-paper-questions/edexcel/2-2-4-government-expenditure/","count":9,"gated":true,"hasPage":true},"3-5-2-supply-of-labour":{"spec":"3.5.2","title":"Supply of Labour","shortTitle":"Supply of Labour","board":"edexcel","boardName":"Edexcel A","group":"theme-3","groupLabel":"Theme 3","groupName":"Business Behaviour and the Labour Market","unit":"3.5","unitName":"Labour Market","notesUrl":"/revision-notes/edexcel-theme-3/3-5-2-supply-of-labour.html","questionsUrl":"/practice-questions/edexcel-theme-3/3-5-2-supply-of-labour.html","url":"/past-paper-questions/edexcel/3-5-2-supply-of-labour/","count":7,"gated":true,"hasPage":true}},"questions":[{"id":"edexcel-a-p1-2025-jun-q3b","p":6,"section":"A","questionNumber":"3(b)","parentQuestion":"3","choiceGroup":null,"marks":4,"questionText":"The diagram below shows the equilibrium position of a dental practice operating in a monopolistically competitive industry. The government subsidises dental care in the UK through the National Health Service (NHS). There has been a large decrease in the work carried out by NHS dentists. Up to 90% of practices are not accepting new NHS patients. Draw an externalities diagram to identify the welfare gain area from the consumption of dental care in the UK.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["positive externality","welfare gain","externalities diagram","dental care"],"qpPage":7,"msPage":6,"ctxPage":6,"modelAnswer":null,"ctxLabel":"Question 3 as printed"},{"id":"edexcel-as-p1-2025-jun-q6e","p":34,"section":"B","questionNumber":"6(e)","parentQuestion":"6","choiceGroup":null,"marks":15,"questionText":"With reference to Extract A, discuss the likely private costs and external costs caused by meat farming. Use an appropriate diagram in your answer.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["external costs","private costs","negative externalities","meat farming"],"qpPage":8,"msPage":14,"ctxPage":27,"modelAnswer":null},{"id":"edexcel-a-p1-2025-jun-q7","p":6,"section":"C","questionNumber":"7","parentQuestion":null,"choiceGroup":"edexcel-a-p1-2025-jun-sec-c","marks":25,"questionText":"High Speed 2 (HS2) was a £100 billion UK government rail project designed to expand the existing network. The journey time between London and Manchester would take just 1 hour and 11 minutes, 54 minutes quicker than today’s fastest time. Almost 900 homes, 1 000 businesses and around 60 ancient woodlands would be destroyed by its construction. Evaluate the likely microeconomic effects of building major infrastructure projects.","topics":["1-3-2-externalities","1-4-1-government-intervention-in-markets"],"board":"edexcel","groups":["theme-1"],"keywords":["HS2","infrastructure","externalities","cost-benefit analysis"],"qpPage":26,"msPage":21,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p1-2025-jun-q8","p":6,"section":"C","questionNumber":"8","parentQuestion":null,"choiceGroup":"edexcel-a-p1-2025-jun-sec-c","marks":25,"questionText":"In 2023, the UK prime minister Rishi Sunak said that he wanted to see all students in England study some form of mathematics until they reach the age of 18 to ‘ensure that they leave school better equipped for the jobs of the future’. This would require additional spending on education. Just half of all 16 to 19 year-olds study mathematics. Yet in a world where data is everywhere and statistics are vital in every job, the workforce will require more analytical skills than ever before. Evaluate the likely microeconomic effects of increased spending on education.","topics":["1-3-2-externalities","3-5-2-supply-of-labour"],"board":"edexcel","groups":["theme-1","theme-3"],"keywords":["education spending","positive externalities","human capital","skills"],"qpPage":26,"msPage":24,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p3-2025-jun-q1a","p":24,"section":"A","questionNumber":"1(a)","parentQuestion":"1","choiceGroup":null,"marks":5,"questionText":"Explain one reason why consumers buy less than the social optimum quantity of healthy food.","topics":["1-3-4-information-gaps","1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["merit goods","information gaps","healthy food","under-consumption"],"qpPage":2,"msPage":4,"ctxPage":31,"modelAnswer":null},{"id":"edexcel-as-p1-2024-jun-q3b","p":33,"section":"A","questionNumber":"3(b)","parentQuestion":"3","choiceGroup":null,"marks":3,"questionText":"Singapore is mainly a free market economy. The education system in Singapore produces some of the highest achieving students in international education rankings, with its teenagers coming top in tests in mathematics, reading and science. Singapore’s education system is provided by the state. With reference to the information above, explain why education is normally provided by the state.","topics":["1-3-2-externalities","1-3-4-information-gaps","1-1-6-types-of-economies"],"board":"edexcel","groups":["theme-1"],"keywords":["state provision","education","positive externalities"],"qpPage":6,"msPage":6,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p1-2024-jun-q6e","p":5,"section":"B","questionNumber":"6(e)","parentQuestion":"6","choiceGroup":null,"marks":15,"questionText":"With reference to Extract D, discuss possible methods of government intervention to reduce electronic waste.","topics":["1-3-2-externalities","1-4-1-government-intervention-in-markets"],"board":"edexcel","groups":["theme-1"],"keywords":["electronic waste","negative externalities","government intervention","recycling"],"qpPage":12,"msPage":21,"ctxPage":10,"modelAnswer":null},{"id":"edexcel-as-p1-2024-jun-q6e","p":33,"section":"B","questionNumber":"6(e)","parentQuestion":"6","choiceGroup":null,"marks":15,"questionText":"Discuss the likely private costs and external costs of the production of plastic.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["private costs","external costs","plastic","externalities"],"qpPage":14,"msPage":16,"ctxPage":12,"modelAnswer":null},{"id":"edexcel-as-p1-2024-jun-q6g","p":33,"section":"B","questionNumber":"6(g)","parentQuestion":"6","choiceGroup":"edexcel-as-p1-2024-jun-q6-choice","marks":20,"questionText":"Evaluate methods of government intervention which could be used to reduce the market failure associated with plastic waste. Use a diagram to support your answer.","topics":["1-4-1-government-intervention-in-markets","1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["government intervention","plastic waste","market failure","regulation"],"qpPage":14,"msPage":22,"ctxPage":12,"modelAnswer":null},{"id":"edexcel-a-p3-2024-jun-q1b","p":23,"section":"A","questionNumber":"1(b)","parentQuestion":"1","choiceGroup":null,"marks":8,"questionText":"Examine one likely externality that arises when a producer generates electricity by burning gas. Use a diagram to show the external costs of production.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["externalities","external costs","gas","emissions","diagram"],"qpPage":5,"msPage":5,"ctxPage":3,"modelAnswer":null},{"id":"edexcel-as-p1-2023-jun-q6b","p":32,"section":"B","questionNumber":"6(b)","parentQuestion":"6","choiceGroup":null,"marks":6,"questionText":"With reference to Extract B, explain two external benefits associated with the consumption of ‘public service broadcasting’ (line 2).","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["external benefits","public service broadcasting","positive externalities"],"qpPage":13,"msPage":13,"ctxPage":11,"modelAnswer":null},{"id":"edexcel-a-p1-2023-jun-q6d","p":4,"section":"B","questionNumber":"6(d)","parentQuestion":"6","choiceGroup":null,"marks":12,"questionText":"With reference to Extract C, discuss the likely private and external benefits of viewing educational websites and TV programmes.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["external benefits","positive externalities","merit goods","education"],"qpPage":15,"msPage":14,"ctxPage":13,"modelAnswer":null},{"id":"edexcel-as-p1-2023-jun-q6f","p":32,"section":"B","questionNumber":"6(f)","parentQuestion":"6","choiceGroup":"edexcel-as-p1-2023-jun-q6-choice","marks":20,"questionText":"Evaluate possible methods of government intervention to reduce the environmental damage caused by the consumption of television content.","topics":["1-4-1-government-intervention-in-markets","1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["government intervention","environmental damage","externalities"],"qpPage":13,"msPage":21,"ctxPage":11,"modelAnswer":null},{"id":"edexcel-a-p1-2023-jun-q8","p":4,"section":"C","questionNumber":"8","parentQuestion":null,"choiceGroup":"edexcel-a-p1-2023-jun-sec-c","marks":25,"questionText":"Using 2021 estimates of carbon emissions, it is estimated that a petrol car journey from London to Glasgow emits approximately 3.3 times more carbon dioxide per passenger than the equivalent journey by train. Evaluate possible methods of government intervention to reduce carbon emissions caused by road transport in the UK.","topics":["1-3-2-externalities","1-4-1-government-intervention-in-markets"],"board":"edexcel","groups":["theme-1"],"keywords":["carbon emissions","negative externalities","carbon tax","road transport"],"qpPage":29,"msPage":23,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p1-2022-jun-q3a","p":3,"section":"A","questionNumber":"3(a)","parentQuestion":"3","choiceGroup":null,"marks":4,"questionText":"A company that provides drinking water and treats waste water has been fined £180 000 after an incident that killed about 2 500 fish. The charges relate to an illegal discharge of sewage from the waste water treatment plant that polluted nine kilometres of the River Severn, a popular tourist destination. Draw an externalities diagram to show the likely impact of the sewage discharge on the local tourist industry.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["negative externality","external costs","externalities diagram","pollution"],"qpPage":6,"msPage":6,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-as-p1-2022-jun-q6f","p":31,"section":"B","questionNumber":"6(f)","parentQuestion":"6","choiceGroup":"edexcel-as-p1-2022-jun-q6-choice","marks":20,"questionText":"Some economists suggest that the market price of cod does not result in the socially optimum level of output. Evaluate the likely external costs from the over-fishing of cod. Use an appropriate diagram in your answer.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["external costs","over-fishing","socially optimum","externalities"],"qpPage":11,"msPage":16,"ctxPage":8,"modelAnswer":null},{"id":"edexcel-as-p1-2022-jun-q6g","p":31,"section":"B","questionNumber":"6(g)","parentQuestion":"6","choiceGroup":"edexcel-as-p1-2022-jun-q6-choice","marks":20,"questionText":"Other than using a TAC, evaluate the policy options which could be used to reduce market failure resulting from over-fishing. Use at least one appropriate diagram in your answer.","topics":["1-4-1-government-intervention-in-markets","1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["government intervention","over-fishing","market failure","tradable permits"],"qpPage":11,"msPage":19,"ctxPage":8,"modelAnswer":null},{"id":"edexcel-a-p3-2022-jun-q1a","p":21,"section":"A","questionNumber":"1(a)","parentQuestion":"1","choiceGroup":null,"marks":5,"questionText":"Using the information provided, explain one externality that arises in the food delivery market.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["externalities","food delivery","congestion","external costs"],"qpPage":5,"msPage":4,"ctxPage":3,"modelAnswer":null},{"id":"edexcel-a-p1-2021-nov-q6b","p":7,"section":"B","questionNumber":"6(b)","parentQuestion":"6","choiceGroup":null,"marks":8,"questionText":"Examine the likely impact of Thomas Cook’s plan ‘to reduce their airline emissions’ (Extract B, line 6) on the social optimum position. Use an appropriate externalities diagram in your answer.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["externalities","social optimum","emissions","airlines","externalities diagram"],"qpPage":16,"msPage":12,"ctxPage":14,"modelAnswer":null},{"id":"edexcel-a-p1-2020-oct-q2a","p":8,"section":"A","questionNumber":"2(a)","parentQuestion":"2","choiceGroup":null,"marks":4,"questionText":"The external benefits of higher education include increased tax revenue, faster economic growth, greater innovation and labour market flexibility. Draw an externalities diagram to show the likely impact of the consumption of higher education.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["positive externality","external benefits","externalities diagram","higher education"],"qpPage":3,"msPage":5,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p1-2020-oct-q3a","p":8,"section":"A","questionNumber":"3(a)","parentQuestion":"3","choiceGroup":null,"marks":4,"questionText":"The EU tradable pollution permits scheme is expected to become more effective by 2020, due to recent reductions in the number of tradable pollution permits. Explain one likely effect of reducing the number of tradable pollution permits.","topics":["1-4-1-government-intervention-in-markets","1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["tradable pollution permits","pollution","government intervention"],"qpPage":4,"msPage":6,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-as-p1-2020-oct-q4b","p":35,"section":"A","questionNumber":"4(b)","parentQuestion":"4","choiceGroup":null,"marks":3,"questionText":"The UK Government uses a range of indirect taxes to affect the market prices and quantities of many goods and services. Using an example, explain why the government imposes specific taxes on many goods and services.","topics":["1-2-9-indirect-taxes-subsidies","1-4-1-government-intervention-in-markets","1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["specific tax","indirect tax","government intervention"],"qpPage":9,"msPage":7,"ctxPage":8,"modelAnswer":null,"ctxLabel":"Question 4 as printed"},{"id":"edexcel-as-p1-2020-oct-q5b","p":35,"section":"A","questionNumber":"5(b)","parentQuestion":"5","choiceGroup":null,"marks":2,"questionText":"HS2 is a high-speed rail network linking the north and south of England. HS2 will be four years late and cost double the Department for Transport’s original estimate. Explain one likely microeconomic reason why the government is using taxpayers’ money to fund HS2.","topics":["1-3-2-externalities","1-3-1-types-of-market-failure","1-4-1-government-intervention-in-markets"],"board":"edexcel","groups":["theme-1"],"keywords":["positive externalities","market failure","HS2","government intervention"],"qpPage":10,"msPage":8,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-as-p1-2020-oct-q6c","p":35,"section":"B","questionNumber":"6(c)","parentQuestion":"6","choiceGroup":null,"marks":6,"questionText":"With reference to Extract A, explain one likely private benefit to students and one likely external benefit of higher education.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["private benefit","external benefit","higher education","externalities"],"qpPage":16,"msPage":12,"ctxPage":14,"modelAnswer":null},{"id":"edexcel-a-p1-2020-oct-q7","p":8,"section":"C","questionNumber":"7","parentQuestion":null,"choiceGroup":"edexcel-a-p1-2020-oct-sec-c","marks":25,"questionText":"The International Energy Agency has predicted that oil use by cars will peak in 2025 because of the increasing number of drivers switching to electric vehicles. Evaluate the likely microeconomic consequences of consumers shifting from vehicles powered by fuel obtained from oil to electric‑powered vehicles.","topics":["1-2-6-price-determination","1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["electric vehicles","derived demand","substitutes","oil","externalities"],"qpPage":26,"msPage":24,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p3-2020-oct-q1c","p":26,"section":"A","questionNumber":"1(c)","parentQuestion":"1","choiceGroup":null,"marks":12,"questionText":"Discuss the likely success of policies to reduce the consumption of single‑use plastic bags in cities such as Istanbul.","topics":["1-4-1-government-intervention-in-markets","1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["plastic bags","government intervention","externalities","charges"],"qpPage":5,"msPage":7,"ctxPage":3,"modelAnswer":null},{"id":"edexcel-a-p3-2019-jun-q1d","p":20,"section":"A","questionNumber":"1(d)","parentQuestion":"1","choiceGroup":"edexcel-a-p3-2019-jun-q1-choice","marks":25,"questionText":"Evaluate the microeconomic and macroeconomic effects of increased government spending on education to promote healthy eating in the UK.","topics":["2-2-4-government-expenditure","1-3-2-externalities"],"board":"edexcel","groups":["theme-1","theme-2"],"keywords":["government spending","education","merit goods","healthy eating"],"qpPage":5,"msPage":8,"ctxPage":3,"modelAnswer":null},{"id":"edexcel-a-p3-2019-jun-q1e","p":20,"section":"A","questionNumber":"1(e)","parentQuestion":"1","choiceGroup":"edexcel-a-p3-2019-jun-q1-choice","marks":25,"questionText":"Evaluate the likely microeconomic and macroeconomic effects of imposing a tax on HFSS foods.","topics":["1-2-9-indirect-taxes-subsidies","1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["sugar tax","HFSS","indirect tax","demerit goods"],"qpPage":5,"msPage":11,"ctxPage":3,"modelAnswer":null},{"id":"edexcel-as-p1-2018-jun-q3b","p":29,"section":"A","questionNumber":"3(b)","parentQuestion":"3","choiceGroup":null,"marks":2,"questionText":"In the UK charges for dental treatment vary. For example, the following charges can be made for a tooth filling: • National Health Service (NHS) dental treatment £50.50 • Private dental treatment £95–£700 A dentist can choose to offer NHS treatment, private treatment or both. Explain one possible reason why the state provides NHS dental treatment.","topics":["1-3-4-information-gaps","1-3-2-externalities","1-1-6-types-of-economies"],"board":"edexcel","groups":["theme-1"],"keywords":["state provision","NHS dental treatment","information gaps"],"qpPage":6,"msPage":6,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-as-p1-2018-jun-q6f","p":29,"section":"B","questionNumber":"6(f)","parentQuestion":"6","choiceGroup":"edexcel-as-p1-2018-jun-q6-choice","marks":20,"questionText":"Using the concept of external costs, evaluate whether nuclear power is under-provided or over-provided in the energy market. Use an appropriate diagram in your answer.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["external costs","nuclear power","over-provision","externalities"],"qpPage":13,"msPage":18,"ctxPage":11,"modelAnswer":null},{"id":"edexcel-as-p1-2018-jun-q6g","p":29,"section":"B","questionNumber":"6(g)","parentQuestion":"6","choiceGroup":"edexcel-as-p1-2018-jun-q6-choice","marks":20,"questionText":"Evaluate ways in which government intervention could be used to reduce carbon emissions. Use at least one appropriate diagram in your answer.","topics":["1-4-1-government-intervention-in-markets","1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["government intervention","carbon emissions","externalities","pollution"],"qpPage":13,"msPage":21,"ctxPage":11,"modelAnswer":null},{"id":"edexcel-a-p1-2018-jun-q7","p":1,"section":"C","questionNumber":"7","parentQuestion":null,"choiceGroup":"edexcel-a-p1-2018-jun-sec-c","marks":25,"questionText":"In September 2016 the government approved the building of an £18 billion nuclear power station, Hinkley Point C, which will supply 7% of UK electricity for up to 60 years. The power station is funded by Chinese and French investment. Evaluate the likely private costs and external costs involved in such major power station construction projects. Use an appropriate externalities diagram in your answer.","topics":["1-3-2-externalities","1-3-1-types-of-market-failure"],"board":"edexcel","groups":["theme-1"],"keywords":["external costs","private costs","Hinkley Point","nuclear power","externalities diagram"],"qpPage":31,"msPage":23,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p3-2018-jun-q1c","p":19,"section":"A","questionNumber":"1(c)","parentQuestion":"1","choiceGroup":null,"marks":8,"questionText":"Examine the advantages of using an indirect tax as a means of reducing the use of disposable coffee cups.","topics":["1-2-9-indirect-taxes-subsidies","1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["indirect tax","latte levy","disposable cups","externalities"],"qpPage":6,"msPage":8,"ctxPage":4,"modelAnswer":null},{"id":"edexcel-a-p1-2017-jun-q7","p":0,"section":"C","questionNumber":"7","parentQuestion":null,"choiceGroup":"edexcel-a-p1-2017-jun-sec-c","marks":25,"questionText":"In 2015 a report by Public Health England recommended the imposition of a 20% tax on the sale of soft drinks that contain high levels of sugar. Evaluate the likely microeconomic effects of such a tax.","topics":["1-2-9-indirect-taxes-subsidies","1-3-2-externalities","1-4-1-government-intervention-in-markets"],"board":"edexcel","groups":["theme-1"],"keywords":["sugar tax","indirect tax","demerit goods","externalities","obesity"],"qpPage":26,"msPage":21,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p3-2017-jun-q1b","p":18,"section":"A","questionNumber":"1(b)","parentQuestion":"1","choiceGroup":null,"marks":8,"questionText":"Examine the likely impact of externalities of copper mining on firms and communities within Chile.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["externalities","copper mining","external costs","pollution"],"qpPage":6,"msPage":5,"ctxPage":4,"modelAnswer":null},{"id":"edexcel-as-p1-2016-jun-q2a","p":27,"section":"A","questionNumber":"2(a)","parentQuestion":"2","choiceGroup":null,"marks":1,"questionText":"Define the term ‘external benefits’.","topics":["1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["external benefits","definition"],"qpPage":3,"msPage":5,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-as-p1-2016-jun-q2c","p":27,"section":"A","questionNumber":"2(c)","parentQuestion":"2","choiceGroup":null,"marks":2,"questionText":"Diagram A shows the market for nursery school places. Annotate on Diagram A the welfare gain area and the new social optimum output resulting from successful government intervention in the market for nursery places.","topics":["1-3-2-externalities","1-4-1-government-intervention-in-markets"],"board":"edexcel","groups":["theme-1"],"keywords":["welfare gain","positive externality","government intervention","diagram"],"qpPage":3,"msPage":5,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-as-p1-2016-jun-q3b","p":27,"section":"A","questionNumber":"3(b)","parentQuestion":"3","choiceGroup":null,"marks":3,"questionText":"The area around Lake Naivasha in Kenya supplies 70% of the UK cut-rose flower market. Much of the water which the flower farms are dependent on is extracted from the lake. This has resulted in damage to fish stocks and increasing competition for water. Explain one measure the Kenyan government could use to reduce the impact of water extraction from Lake Naivasha.","topics":["1-4-1-government-intervention-in-markets","1-3-2-externalities"],"board":"edexcel","groups":["theme-1"],"keywords":["government intervention","regulation","externalities","Lake Naivasha"],"qpPage":4,"msPage":6,"ctxPage":null,"modelAnswer":null}]}
