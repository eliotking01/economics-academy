Page":true},"1-2-6-price-determination":{"spec":"1.2.6","title":"Price Determination","shortTitle":"Price Determination","board":"edexcel","boardName":"Edexcel A","group":"theme-1","groupLabel":"Theme 1","groupName":"Introduction to Markets and Market Failure","unit":"1.2","unitName":"How Markets Work","notesUrl":"/revision-notes/edexcel-theme-1/1-2-6-price-determination.html","questionsUrl":"/practice-questions/edexcel-theme-1/1-2-6-price-determination.html","url":"/past-paper-questions/edexcel/1-2-6-price-determination/","count":28,"gated":true,"hasPage":true},"4-1-3-pattern-of-trade":{"spec":"4.1.3","title":"Pattern of Trade","shortTitle":"Pattern of Trade","board":"edexcel","boardName":"Edexcel A","group":"theme-4","groupLabel":"Theme 4","groupName":"A Global Perspective","unit":"4.1","unitName":"International Economics","notesUrl":"/revision-notes/edexcel-theme-4/4-1-3-pattern-of-trade.html","questionsUrl":"/practice-questions/edexcel-theme-4/4-1-3-pattern-of-trade.html","url":"/past-paper-questions/edexcel/4-1-3-pattern-of-trade/","count":4,"gated":true,"hasPage":true},"4-3-3-strategies-influencing-growth-development":{"spec":"4.3.3","title":"Strategies Influencing Growth and Development","shortTitle":"Development Strategies","board":"edexcel","boardName":"Edexcel A","group":"theme-4","groupLabel":"Theme 4","groupName":"A Global Perspective","unit":"4.3","unitName":"Emerging and Developing Economies","notesUrl":"/revision-notes/edexcel-theme-4/4-3-3-strategies-influencing-growth-development.html","questionsUrl":"/practice-questions/edexcel-theme-4/4-3-3-strategies-influencing-growth-development.html","url":"/past-paper-questions/edexcel/4-3-3-strategies-influencing-growth-development/","count":18,"gated":true,"hasPage":true}},"questions":[{"id":"edexcel-a-p1-2025-jun-q2a","p":6,"section":"A","questionNumber":"2(a)","parentQuestion":"2","choiceGroup":null,"marks":4,"questionText":"In 2022 the UK government provided 130 new licences for North Sea oil and gas exploration, in order to reduce energy prices. However, companies can take 20 years to begin to extract oil. Furthermore, they often have to continue producing oil even when prices fall because the equipment has no other uses. With reference to the data above, explain the likely numerical value of the price elasticity of supply for oil.","topics":["1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","oil","North Sea"],"qpPage":4,"msPage":5,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-as-p1-2025-jun-q6c","p":34,"section":"B","questionNumber":"6(c)","parentQuestion":"6","choiceGroup":null,"marks":6,"questionText":"With reference to the last paragraph of Extract B, explain two factors which are likely to influence price elasticity of supply.","topics":["1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","PES","determinants"],"qpPage":8,"msPage":12,"ctxPage":27,"modelAnswer":null},{"id":"edexcel-a-p1-2024-jun-q2a","p":5,"section":"A","questionNumber":"2(a)","parentQuestion":"2","choiceGroup":null,"marks":4,"questionText":"The table below shows price elasticity of supply for housing in the US in 2020. With reference to the data above, explain one likely reason for the difference in the price elasticity of supply.","topics":["1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","determinants of PES","housing"],"qpPage":4,"msPage":7,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p1-2024-jun-q2b","p":5,"section":"A","questionNumber":"2(b)","parentQuestion":"2","choiceGroup":null,"marks":1,"questionText":"The table below shows price elasticity of supply for housing in the US in 2020. In Texas the price elasticity of supply is +1.8. Which one of the following is the percentage increase in price if the quantity of housing supplied in Texas is increased by 12%?","topics":["1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","PES calculation","housing"],"qpPage":5,"msPage":8,"ctxPage":4,"modelAnswer":null,"ctxLabel":"Question 2 as printed","type":"mcq","options":["0.15","1.50","6.67","21.60"],"usesFigure":true},{"id":"edexcel-as-p1-2023-jun-q2a","p":32,"section":"A","questionNumber":"2(a)","parentQuestion":"2","choiceGroup":null,"marks":3,"questionText":"The world’s largest producer of natural gas is the USA. In 2021 production fell even though the price increased. Using the data provided, explain one likely factor that may influence the price elasticity of supply of gas.","topics":["1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","determinants of PES","natural gas"],"qpPage":4,"msPage":6,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-as-p1-2023-jun-q2b","p":32,"section":"A","questionNumber":"2(b)","parentQuestion":"2","choiceGroup":null,"marks":1,"questionText":"The world’s largest producer of natural gas is the USA. In 2021 production fell even though the price increased. The table below shows estimates of the price elasticity of supply and price elasticity of demand for gas. Which one of the following can be inferred from the table?","topics":["1-2-5-price-elasticity-of-supply","1-2-3-price-income-cross-elasticities-of-demand"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","price elasticity of demand","natural gas"],"qpPage":5,"msPage":6,"ctxPage":4,"modelAnswer":null,"ctxLabel":"Question 2 as printed","type":"mcq","options":["A 10% increase in the price of gas would cause a more than 10% increase in the supply","Gas is a normal good with income inelastic demand","The demand and supply of gas are both price inelastic","The demand for gas is more responsive to changes in price than supply"],"usesFigure":true},{"id":"edexcel-as-p1-2022-jun-q5a","p":31,"section":"A","questionNumber":"5(a)","parentQuestion":"5","choiceGroup":null,"marks":3,"questionText":"In March 2020, a substantial increase in the demand for flour resulted in the retail price of flour increasing. Despite the price rises, the supply of flour failed to keep up with the increased demand. Explain one reason why flour producers might find it difficult to increase quantity supplied in the short run.","topics":["1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","short run","flour"],"qpPage":7,"msPage":8,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-as-p1-2022-jun-q5b","p":31,"section":"A","questionNumber":"5(b)","parentQuestion":"5","choiceGroup":null,"marks":1,"questionText":"In March 2020, a substantial increase in the demand for flour resulted in the retail price of flour increasing. Despite the price rises, the supply of flour failed to keep up with the increased demand. A manufacturer has estimated that the price elasticity of supply of ice cream is +1.5. If the demand for ice cream rises and the price increases by 10%, which one of the following is the resulting percentage change in supply?","topics":["1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","PES calculation","ice cream"],"qpPage":7,"msPage":8,"ctxPage":null,"modelAnswer":null,"type":"mcq","options":["0.15%","1.5%","6.67%","15%"],"usesFigure":false},{"id":"edexcel-a-p1-2022-jun-q6b","p":3,"section":"B","questionNumber":"6(b)","parentQuestion":"6","choiceGroup":null,"marks":8,"questionText":"With reference to Figure 2 and your understanding of price elasticity, examine two factors that may cause significant changes in the international price of coffee beans.","topics":["1-2-5-price-elasticity-of-supply","1-2-6-price-determination"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","PES","commodity prices","coffee"],"qpPage":15,"msPage":11,"ctxPage":14,"modelAnswer":null},{"id":"edexcel-a-p2-2020-oct-q6b","p":17,"section":"B","questionNumber":"6(b)","parentQuestion":"6","choiceGroup":null,"marks":8,"questionText":"Examine two ways, apart from Fairtrade schemes, in which cocoa farmers could boost their incomes despite the falling price of cocoa.","topics":["4-3-3-strategies-influencing-growth-development","1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1","theme-4"],"keywords":["commodity prices","cocoa","farmers","development strategies"],"qpPage":11,"msPage":10,"ctxPage":10,"modelAnswer":null},{"id":"edexcel-a-p1-2019-jun-q1a","p":2,"section":"A","questionNumber":"1(a)","parentQuestion":"1","choiceGroup":null,"marks":2,"questionText":"Between 2016 and 2017 the average price of new build houses in the UK rose by an estimated 5.4%. With reference to the data provided, calculate the price elasticity of supply for new house builds between 2016 and 2017. You are advised to show your workings.","topics":["1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","PES calculation","new build houses"],"qpPage":2,"msPage":4,"ctxPage":null,"modelAnswer":null},{"id":"edexcel-a-p1-2019-jun-q1b","p":2,"section":"A","questionNumber":"1(b)","parentQuestion":"1","choiceGroup":null,"marks":1,"questionText":"Between 2016 and 2017 the average price of new build houses in the UK rose by an estimated 5.4%. A 2.5% increase in new build house prices in one region of the UK causes a 10% increase in the number of houses built. Ceteris paribus, this suggests that supply of new house builds is:","topics":["1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","PES","new build houses"],"qpPage":2,"msPage":4,"ctxPage":null,"modelAnswer":null,"type":"mcq","options":["perfectly price elastic","perfectly price inelastic","relatively price elastic","relatively price inelastic"],"usesFigure":true},{"id":"edexcel-a-p1-2019-jun-q1c","p":2,"section":"A","questionNumber":"1(c)","parentQuestion":"1","choiceGroup":null,"marks":2,"questionText":"Between 2016 and 2017 the average price of new build houses in the UK rose by an estimated 5.4%. Explain one factor that is likely to determine the price elasticity of supply of new house builds.","topics":["1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1"],"keywords":["determinants of PES","price elasticity of supply","housing"],"qpPage":3,"msPage":4,"ctxPage":2,"modelAnswer":null,"ctxLabel":"Question 1 as printed"},{"id":"edexcel-as-p1-2018-jun-q6b","p":29,"section":"B","questionNumber":"6(b)","parentQuestion":"6","choiceGroup":null,"marks":10,"questionText":"With reference to Extract A and your own knowledge, assess whether the supply of uranium is likely to be price elastic or price inelastic.","topics":["1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","uranium","PES","mining"],"qpPage":13,"msPage":11,"ctxPage":11,"modelAnswer":null},{"id":"edexcel-a-p3-2018-jun-q2d","p":19,"section":"B","questionNumber":"2(d)","parentQuestion":"2","choiceGroup":"edexcel-a-p3-2018-jun-q2-choice","marks":25,"questionText":"With reference to the information provided and your own knowledge, evaluate the microeconomic and macroeconomic effects on Indonesia of the volatility of prices of commodities such as coal.","topics":["4-1-3-pattern-of-trade","1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1","theme-4"],"keywords":["commodity price volatility","primary products","Indonesia"],"qpPage":23,"msPage":20,"ctxPage":21,"modelAnswer":null},{"id":"edexcel-as-p1-2016-jun-q6a","p":27,"section":"B","questionNumber":"6(a)","parentQuestion":"6","choiceGroup":null,"marks":5,"questionText":"With reference to Figure 1, explain one possible reason for the differences in price elasticity of supply of new housing between countries.","topics":["1-2-5-price-elasticity-of-supply"],"board":"edexcel","groups":["theme-1"],"keywords":["price elasticity of supply","housing","new housing","PES"],"qpPage":10,"msPage":9,"ctxPage":9,"modelAnswer":null}]}
