rmation-gaps"],"board":"edexcel","groups":["theme-1","theme-4"],"keywords":["asymmetric information","loan scheme","financial sector"],"qpPage":11,"msPage":9,"ctxPage":10,"modelAnswer":null,"ctxLabel":"Question 5 as printed","type":"mcq","options":["Asymmetric information","Crowding out","Market rigging","Speculation"],"usesFigure":false},{"id":"edexcel-a-p1-2021-nov-q6c","p":7,"section":"B","questionNumber":"6(c)","parentQuestion":"6","choiceGroup":null,"marks":10,"questionText":"With reference to Extract C, assess whether Thomas Cook’s failure was caused by the principal-agent problem.","topics":["3-2-1-business-objectives","1-3-4-information-gaps"],"board":"edexcel","groups":["theme-1","theme-3"],"keywords":["principal-agent problem","business objectives","Thomas Cook","asymmetric information"],"qpPage":16,"msPage":14,"ctxPage":14,"modelAnswer":null},{"id":"edexcel-as-p1-2019-jun-q6b","p":30,"section":"B","questionNumber":"6(b)","parentQuestion":"6","choiceGroup":null,"marks":6,"questionText":"Explain how ‘asymmetric information’ (Extract B, line 30) can lead to market failure in health provision.","topics":["1-3-4-information-gaps"],"board":"edexcel","groups":["theme-1"],"keywords":["asymmetric information","information gaps","market failure","health"],"qpPage":16,"msPage":12,"ctxPage":13,"modelAnswer":null},{"id":"edexcel-a-p1-2019-jun-q6c","p":2,"section":"B","questionNumber":"6(c)","parentQuestion":"6","choiceGroup":null,"marks":10,"questionText":"With reference to Extract C, assess possible reasons why many ‘landline-only’ customers do not switch to a cheaper telephone provider.","topics":["1-3-4-information-gaps","1-2-10-alternative-views-of-consumer-behaviour"],"board":"edexcel","groups":["theme-1"],"keywords":["information gaps","switching","consumer inertia","behavioural economics"],"qpPage":13,"msPage":12,"ctxPage":11,"modelAnswer":null},{"id":"edexcel-as-p1-2018-jun-q3b","p":29,"section":"A","questionNumber":"3(b)","parentQuestion":"3","choiceGroup":nu