qa-a2-macro/2-5-1-fiscal-policy.html","url":"/past-paper-questions/aqa/2-5-1-fiscal-policy/","count":22,"gated":true,"hasPage":true},"2-5-2-supply-side-policies":{"spec":"2.5.2","title":"Supply-Side Policies","shortTitle":"Supply-Side Policies","board":"aqa","boardName":"AQA","group":"macroeconomics","groupLabel":"Macroeconomics","groupName":"The National and International Economy","unit":"2.5","unitName":"Fiscal Policy and Supply-Side Policies","notesUrl":"/revision-notes/aqa-a2-macro/2-5-2-supply-side-policies.html","questionsUrl":"/practice-questions/aqa-a2-macro/2-5-2-supply-side-policies.html","url":"/past-paper-questions/aqa/2-5-2-supply-side-policies/","count":9,"gated":true,"hasPage":true}},"questions":[{"id":"aqa-p1-2024-jun-q4","p":47,"section":"A","questionNumber":"4","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"Extract C (lines 14–16) states that ‘A maximum rent can help keep the cost of student accommodation lower than it would otherwise be, but risks some landlords withdrawing from the market’. Using the data in the extracts and your knowledge of economics, discuss the advantages and disadvantages of policies the government might introduce to improve the market for student accommodation.","topics":["1-8-9-government-intervention-in-markets"],"board":"aqa","groups":["microeconomics"],"keywords":["maximum price","rent control","government intervention","shortage"],"qpPage":3,"msPage":9,"ctxPage":2,"modelAnswer":null},{"id":"aqa-p1-2023-jun-q4","p":46,"section":"A","questionNumber":"4","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"Extract B (lines 20–21) states that ‘all vehicle owners should be forced to pay the full costs of their driving. This would incentivise people to consider using public transport, cycling or walking.’ Evaluate policies that could be used to reduce the environmental impact of all types of car.","topics":["1-8-9-government-intervention-in-markets","1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["road pricing","full cost","externalities","government intervention"],"qpPage":3,"msPage":9,"ctxPage":2,"modelAnswer":null},{"id":"aqa-p1-2022-jun-q10","p":45,"section":"B","questionNumber":"10","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"Assess the view that high-speed Internet connection is a necessity for modern life and should be provided by the government, free of charge, to all households.","topics":["1-8-3-public-goods-private-goods-and-quasi-public-goods","1-8-9-government-intervention-in-markets"],"board":"aqa","groups":["microeconomics"],"keywords":["quasi-public goods","broadband","state provision","merit goods"],"qpPage":6,"msPage":17,"ctxPage":null,"modelAnswer":null},{"id":"aqa-p3-2022-jun-q33","p":61,"section":"B","questionNumber":"33","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"After considering Extract D, and the original evidence in Extracts A, B and C, would you recommend that the UK government provides financial and other support to companies involved in the production of commercial aircraft? Justify your recommendation.","topics":["1-8-9-government-intervention-in-markets","2-5-2-supply-side-policies"],"board":"aqa","groups":["macroeconomics","microeconomics"],"keywords":["state aid","subsidy","industrial policy","aerospace"],"qpPage":36,"msPage":11,"ctxPage":28,"modelAnswer":null},{"id":"aqa-p3-2021-jun-q33","p":60,"section":"B","questionNumber":"33","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"After considering Extract E, and the original evidence in Extracts A, B, C and D, which policies, if any, would you recommend that the UK government should introduce to ensure that it achieves its zero-emissions target by 2050. Justify your recommendation.","topics":["1-8-9-government-intervention-in-markets"],"board":"aqa","groups":["microeconomics"],"keywords":["carbon tax","regulation","emissions","government intervention"],"qpPage":30,"msPage":8,"ctxPage":21,"modelAnswer":null},{"id":"aqa-p1-2020-jun-q4","p":43,"section":"A","questionNumber":"4","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"Extract C (lines 17–19) states: ‘Many environmental economists suggest that making firms pay for the costs of landfill associated with their products, or taxing raw material inputs, will be necessary to ensure a sustainable future for all.’ Using the extracts and your knowledge of economics, evaluate policies, if any, that governments in developed countries should pursue to reduce waste and encourage the recycling of waste products.","topics":["1-8-9-government-intervention-in-markets","1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["landfill tax","polluter pays","externalities","intervention"],"qpPage":3,"msPage":9,"ctxPage":2,"modelAnswer":null},{"id":"aqa-p1-2020-jun-q8","p":43,"section":"A","questionNumber":"8","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"Extract F (lines 1–3) states: ‘There are aspects of market failure in the social care sector, though some argue that inappropriate government intervention and a lack of funding are the main reasons why the system is failing to deliver high quality care.’ Using the extracts and your knowledge of economics, assess policies that might be used to improve the provision of social care in the UK.","topics":["1-8-2-the-meaning-of-market-failure","1-8-9-government-intervention-in-markets"],"board":"aqa","groups":["microeconomics"],"keywords":["market failure","social care","government intervention"],"qpPage":5,"msPage":14,"ctxPage":4,"modelAnswer":null},{"id":"aqa-p1-2019-jun-q5","p":42,"section":"A","questionNumber":"5","parentQuestion":null,"choiceGroup":null,"marks":2,"questionText":"Using the data in Extract D (Figure 3), calculate the amount of government funding per £ of passenger income in the UK rail industry for the year 2015–16. Give your answer correct to the nearest penny.","topics":["1-8-9-government-intervention-in-markets"],"board":"aqa","groups":["microeconomics"],"keywords":["subsidy","rail","government funding","calculation"],"qpPage":5,"msPage":10,"ctxPage":4,"modelAnswer":null},{"id":"aqa-p1-2019-jun-q13","p":42,"section":"B","questionNumber":"13","parentQuestion":null,"choiceGroup":null,"marks":15,"questionText":"Explain how the impact of a minimum price for a good or service is affected by its price elasticity of demand and its price elasticity of supply.","topics":["1-8-9-government-intervention-in-markets","1-3-2-price-income-and-cross-elasticities-of-demand"],"board":"aqa","groups":["microeconomics"],"keywords":["minimum price","elasticity","government intervention"],"qpPage":7,"msPage":20,"ctxPage":null,"modelAnswer":null},{"id":"aqa-p3-2019-jun-q33","p":58,"section":"B","questionNumber":"33","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"After considering Extract E, and the original evidence in Extracts A, B, C and D, would you recommend that the Government should increase its spending on housing? Justify your recommendation.","topics":["1-8-9-government-intervention-in-markets","2-5-1-fiscal-policy"],"board":"aqa","groups":["macroeconomics","microeconomics"],"keywords":["housing","government spending","intervention","affordability"],"qpPage":27,"msPage":10,"ctxPage":18,"modelAnswer":null},{"id":"aqa-p1-2018-jun-q8","p":41,"section":"A","questionNumber":"8","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"Extract E (lines 14–16) states that ‘The market economy is not going to create the jobs by itself for those workers who are most affected by the change.’ Extract F (lines 4–5) states that ‘taxing productivity-enhancing tools like robots or machines makes no economic sense.’ Use the extracts and your own knowledge of economics to evaluate whether governments should allow markets to respond freely to the opportunities and challenges presented by technological progress, without any state intervention.","topics":["1-6-2-influence-upon-the-supply-of-labour-to-different-markets","1-8-9-government-intervention-in-markets"],"board":"aqa","groups":["microeconomics"],"keywords":["structural unemployment","retraining","automation","intervention"],"qpPage":5,"msPage":15,"ctxPage":4,"modelAnswer":null},{"id":"aqa-p1-2018-jun-q10","p":41,"section":"B","questionNumber":"10","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"Assess the view that regulation is a better policy for dealing with the problem of air pollution than the allocation of property rights or taxation.","topics":["1-8-9-government-intervention-in-markets","1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["regulation","tradable permits","pollution","government intervention"],"qpPage":6,"msPage":18,"ctxPage":null,"modelAnswer":null},{"id":"aqa-p1-2017-jun-q14","p":40,"section":"B","questionNumber":"14","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"Evaluate the view that imposing a tax is the most effective government policy for reducing the market failures arising from overconsumption of unhealthy food and drink.","topics":["1-8-9-government-intervention-in-markets","1-8-5-merit-and-demerit-goods"],"board":"aqa","groups":["microeconomics"],"keywords":["sugar tax","indirect tax","demerit goods","government intervention"],"qpPage":7,"msPage":22,"ctxPage":null,"modelAnswer":null}]}
