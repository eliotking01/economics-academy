roduction.html","questionsUrl":"/practice-questions/aqa-a2-micro/1-8-4-positive-and-negative-externalities-in-consumption-and-production.html","url":"/past-paper-questions/aqa/1-8-4-positive-and-negative-externalities-in-consumption-and-production/","count":11,"gated":true,"hasPage":true},"1-8-5-merit-and-demerit-goods":{"spec":"1.8.5","title":"Merit and Demerit Goods","shortTitle":"Merit and Demerit Goods","board":"aqa","boardName":"AQA","group":"microeconomics","groupLabel":"Microeconomics","groupName":"Individuals, Firms, Markets and Market Failure","unit":"1.8","unitName":"The Market Mechanism, Market Failure and Government Intervention in Markets","notesUrl":"/revision-notes/aqa-a2-micro/1-8-5-merit-and-demerit-goods.html","questionsUrl":"/practice-questions/aqa-a2-micro/1-8-5-merit-and-demerit-goods.html","url":"/past-paper-questions/aqa/1-8-5-merit-and-demerit-goods/","count":3,"gated":false,"hasPage":false},"1-8-9-government-intervention-in-markets":{"spec":"1.8.9","title":"Government Intervention in Markets","shortTitle":"Government Intervention","board":"aqa","boardName":"AQA","group":"microeconomics","groupLabel":"Microeconomics","groupName":"Individuals, Firms, Markets and Market Failure","unit":"1.8","unitName":"The Market Mechanism, Market Failure and Government Intervention in Markets","notesUrl":"/revision-notes/aqa-a2-micro/1-8-9-government-intervention-in-markets.html","questionsUrl":"/practice-questions/aqa-a2-micro/1-8-9-government-intervention-in-markets.html","url":"/past-paper-questions/aqa/1-8-9-government-intervention-in-markets/","count":13,"gated":true,"hasPage":true}},"questions":[{"id":"aqa-p1-2023-jun-q3","p":46,"section":"A","questionNumber":"3","parentQuestion":null,"choiceGroup":null,"marks":9,"questionText":"Extract C (lines 3–4) states that ‘the mining, manufacturing and disposal process for batteries could soon become an environmental disaster.’ With the help of a diagram, explain why the production and sale of lithium-ion batteries might lead to market failure.","topics":["1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["batteries","external costs","electric vehicles","externalities"],"qpPage":3,"msPage":7,"ctxPage":2,"modelAnswer":null},{"id":"aqa-p1-2023-jun-q4","p":46,"section":"A","questionNumber":"4","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"Extract B (lines 20–21) states that ‘all vehicle owners should be forced to pay the full costs of their driving. This would incentivise people to consider using public transport, cycling or walking.’ Evaluate policies that could be used to reduce the environmental impact of all types of car.","topics":["1-8-9-government-intervention-in-markets","1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["road pricing","full cost","externalities","government intervention"],"qpPage":3,"msPage":9,"ctxPage":2,"modelAnswer":null},{"id":"aqa-p3-2021-jun-q31","p":60,"section":"B","questionNumber":"31","parentQuestion":null,"choiceGroup":null,"marks":10,"questionText":"The UK government has set a target to reduce net greenhouse gas (GHG) emissions to zero by 2050. To what extent, if at all, do the data suggest that to achieve its net-zero emissions target, the government should focus on reducing GHG emissions from the transport sector? You must use the data in Extract C to support your assessment.","topics":["1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["greenhouse gas","net zero","externalities","data response"],"qpPage":21,"msPage":5,"ctxPage":21,"modelAnswer":null},{"id":"aqa-p3-2021-jun-q32","p":60,"section":"B","questionNumber":"32","parentQuestion":null,"choiceGroup":null,"marks":15,"questionText":"Explain why, without government intervention, markets are likely to allocate too few resources to dealing with the problem of climate change.","topics":["1-8-2-the-meaning-of-market-failure","1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["market failure","climate change","externalities","resource allocation"],"qpPage":25,"msPage":7,"ctxPage":21,"modelAnswer":null},{"id":"aqa-p1-2020-jun-q1","p":43,"section":"A","questionNumber":"1","parentQuestion":null,"choiceGroup":null,"marks":2,"questionText":"Using the data in Extract A (Figure 1) calculate the percentage of all plastics produced in the period 1950–2015 which have either been sent to landfill or incinerated. Give your answer to one decimal place.","topics":["1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["plastic waste","externalities","calculation"],"qpPage":3,"msPage":5,"ctxPage":2,"modelAnswer":null},{"id":"aqa-p1-2020-jun-q2","p":43,"section":"A","questionNumber":"2","parentQuestion":null,"choiceGroup":null,"marks":4,"questionText":"Explain how the data in Extract A (Figure 2) show that higher living standards lead to greater volumes of waste per capita being produced.","topics":["1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["waste per capita","living standards","negative externalities"],"qpPage":3,"msPage":6,"ctxPage":2,"modelAnswer":null},{"id":"aqa-p1-2020-jun-q4","p":43,"section":"A","questionNumber":"4","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"Extract C (lines 17–19) states: ‘Many environmental economists suggest that making firms pay for the costs of landfill associated with their products, or taxing raw material inputs, will be necessary to ensure a sustainable future for all.’ Using the extracts and your knowledge of economics, evaluate policies, if any, that governments in developed countries should pursue to reduce waste and encourage the recycling of waste products.","topics":["1-8-9-government-intervention-in-markets","1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["landfill tax","polluter pays","externalities","intervention"],"qpPage":3,"msPage":9,"ctxPage":2,"modelAnswer":null},{"id":"aqa-p1-2018-jun-q9","p":41,"section":"B","questionNumber":"9","parentQuestion":null,"choiceGroup":null,"marks":15,"questionText":"Explain why the use of petrol and diesel cars may be a source of market failure.","topics":["1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["air pollution","negative externalities","cars","market failure"],"qpPage":6,"msPage":17,"ctxPage":null,"modelAnswer":null},{"id":"aqa-p1-2018-jun-q10","p":41,"section":"B","questionNumber":"10","parentQuestion":null,"choiceGroup":null,"marks":25,"questionText":"Assess the view that regulation is a better policy for dealing with the problem of air pollution than the allocation of property rights or taxation.","topics":["1-8-9-government-intervention-in-markets","1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["regulation","tradable permits","pollution","government intervention"],"qpPage":6,"msPage":18,"ctxPage":null,"modelAnswer":null},{"id":"aqa-p3-2018-jun-q31","p":57,"section":"B","questionNumber":"31","parentQuestion":null,"choiceGroup":null,"marks":10,"questionText":"To what extent, if at all, do the data suggest that the reliance on fossil fuels to produce energy is falling? You must use the data in Extract C to support your assessment.","topics":["1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["fossil fuels","energy","externalities","data response"],"qpPage":24,"msPage":5,"ctxPage":24,"modelAnswer":null},{"id":"aqa-p1-2017-jun-q13","p":40,"section":"B","questionNumber":"13","parentQuestion":null,"choiceGroup":null,"marks":15,"questionText":"Explain why, in a free market, sugary drinks may be overconsumed.","topics":["1-8-5-merit-and-demerit-goods","1-8-4-positive-and-negative-externalities-in-consumption-and-production"],"board":"aqa","groups":["microeconomics"],"keywords":["sugary drinks","demerit goods","overconsumption","externalities"],"qpPage":7,"msPage":21,"ctxPage":null,"modelAnswer":null}]}
